# Секрет для подписи cookie-сессий (обязательно смените в продакшене, >= 32 символов)
SECRET_KEY=replace-with-long-random-string

# Опционально: ключ для GET /api/posts без браузерной сессии (заголовок X-API-Key)
# API_KEY=

# Опционально: строка подключения SQLAlchemy (по умолчанию sqlite:///./social_media.db)
# DATABASE_URL=sqlite:///./social_media.db

# Для тестов: отключить rate limit (1 / true / yes)
# DISABLE_RATE_LIMIT=1
